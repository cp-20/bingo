# ローカルではファイルDB。本番は永続化された外部libSQL/Tursoを必ず設定。
TURSO_DATABASE_URL=file:data/bingo.db
TURSO_AUTH_TOKEN=
APP_URL=http://localhost:3000
# Stripe Checkout Sessionsの作成・参照権限を持つ制限付きキー
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# 現在の実装はsandbox専用。本番キーは拒否します。
# 販売者情報（本販売開始前に設定する。公開ページに表示されます）
SELLER_NAME=
SELLER_EMAIL=
SELLER_ADDRESS=
SELLER_PHONE=
