{
  "name": "bingo-party",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build && node scripts/standalone.mjs",
    "start": "HOSTNAME=0.0.0.0 node .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:http": "node scripts/smoke.mjs",
    "test:e2e": "playwright test",
    "db:setup": "node --env-file-if-exists=.env.local --import tsx scripts/setup-db.ts",
    "db:cleanup": "node --env-file-if-exists=.env.local --import tsx scripts/cleanup-db.ts",
    "db:backup": "node --env-file-if-exists=.env.local --import tsx scripts/backup-db.ts",
    "db:restore": "node --import tsx scripts/restore-db.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "next": "16.4.4",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "stripe": "23.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
